{
  "theme": "base",
  "securityLevel": "strict",
  "fontFamily": "Arial, PingFang SC, Microsoft YaHei, sans-serif",
  "themeVariables": {
    "fontSize": "16px",
    "lineColor": "#8291a5",
    "textColor": "#17304f",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#c7d2df"
